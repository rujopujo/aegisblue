# =============================================================================
# AegisBlue - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your private values.
# NEVER commit the actual .env file containing real keys or secrets to git.

# -----------------------------------------------------------------------------
# Smart Contract Deployment (Hardhat backend only - NEVER expose with VITE_ prefix)
# -----------------------------------------------------------------------------
# Deployer wallet private key on Polygon Amoy (64-character hex, omit or include 0x)
AMOY_PRIVATE_KEY=your_deployer_private_key_here

# Polygon Amoy RPC endpoint
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# PolygonScan API key for contract verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# -----------------------------------------------------------------------------
# Backend IPFS / Pinata Credentials (Server-side ONLY - NEVER expose with VITE_)
# -----------------------------------------------------------------------------
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# -----------------------------------------------------------------------------
# Client-Side Application Settings (VITE_ variables exposed in browser bundle)
# WARNING: NEVER put private keys, deployer keys, or secret tokens here!
# -----------------------------------------------------------------------------
VITE_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
VITE_CHAIN_ID=80002
VITE_CONTRACT_ADDRESS=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

